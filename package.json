{
  "name": "cardstock",
  "private": true,
  "version": "0.10.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:scan": "node tests/harness/run-matrix.mjs",
    "test:lowlight": "node tests/harness/run-matrix.mjs --degradations=lowlight,dim,dark --mode=hinted --stack=3",
    "test:capture": "node tests/harness/capture-stack.mjs",
    "sync": "node server/sync-server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.8",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.1.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.4"
  }
}
