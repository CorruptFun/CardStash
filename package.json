{
  "name": "cardstock",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "icons": "node scripts/make-icons.mjs",
    "icons:check": "node scripts/make-icons.mjs --check",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:scan": "node tests/harness/run-matrix.mjs",
    "test:corpus": "node --max-old-space-size=6144 tests/corpus/sweep-names.mjs --sample=600 --out=names-sample && node --max-old-space-size=6144 tests/corpus/sweep-codes.mjs --sample=3000 --out=codes-sample",
    "test:corpus:full": "node --max-old-space-size=8192 tests/corpus/sweep-names.mjs && node --max-old-space-size=8192 tests/corpus/sweep-codes.mjs",
    "test:scanui": "node tests/harness/drive-scan-ui.mjs",
    "test:batch": "node tests/harness/batch-add-ui.mjs",
    "test:invite": "node tests/harness/invite-ui.mjs",
    "test:lowlight": "node tests/harness/run-matrix.mjs --degradations=lowlight,dim,dark --mode=hinted --stack=3",
    "test:capture": "node tests/harness/capture-stack.mjs",
    "test:camera": "node tests/harness/camera-lifecycle.mjs",
    "test:foil": "node tests/harness/run-matrix.mjs --degradations=foil,foil-worst --mode=hinted",
    "test:foiltext": "node tests/harness/run-matrix.mjs --degradations=foil-text,foil-text-silver,foil-text-worst --mode=hinted",
    "test:photos": "node tests/harness/run-matrix.mjs --photos-only",
    "test:clips": "node tests/harness/run-matrix.mjs --clips-only --pages=1",
    "test:binder": "node tests/harness/binder-ui.mjs",
    "test:collection": "node tests/harness/collection-ui.mjs",
    "test:misshelp": "node tests/harness/miss-help-ui.mjs",
    "test:install": "node tests/harness/install-prompt.mjs",
    "test:cloud": "node tests/harness/cloud-live.mjs",
    "test:social": "node tests/harness/social-rls.mjs",
    "test:messages": "node tests/harness/messages-rls.mjs",
    "test:cardsource": "node tests/harness/cardsource-rls.mjs",
    "test:mirror": "node tests/harness/catalog-rls.mjs",
    "test:escrow": "node tests/harness/escrow-rls.mjs",
    "build:marketing": "node scripts/build-marketing.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.8",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.1.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.4"
  }
}
